{
  "name": "solution-arch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public site teaching senior-architect concepts as interactive Motion Canvas animations",
  "author": "Salah Awad <salah.awad@outlook.com>",
  "license": "MIT",
  "homepage": "https://solution-arch.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/salahawad/solution-arch.git"
  },
  "bugs": {
    "url": "https://github.com/salahawad/solution-arch/issues"
  },
  "keywords": [
    "system-design",
    "software-architecture",
    "motion-canvas",
    "animations",
    "astro",
    "education"
  ],
  "engines": {
    "node": ">=20 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  },
  "scripts": {
    "dev:anim": "pnpm --filter @sa/animations dev",
    "dev:site": "pnpm --filter @sa/site dev",
    "build:embeds": "pnpm --filter @sa/animations build:embeds",
    "build:posters": "pnpm --filter @sa/animations posters",
    "build:reels": "pnpm --filter @sa/animations reels",
    "build:site": "pnpm --filter @sa/site build",
    "build": "pnpm run build:site",
    "rebuild:all": "pnpm run build:embeds && pnpm run build:posters && pnpm run build:site"
  }
}
