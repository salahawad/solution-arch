---
import Base from "../../layouts/Base.astro";
import ConceptCard from "../../components/ConceptCard.astro";
import concepts from "../../concepts.json";
import { posterUrl } from "../../lib/posterUrl";
import { CATEGORY_ORDER } from "../../lib/categories";

export function getStaticPaths() {
  return concepts.map((c) => ({ params: { slug: c.slug }, props: { concept: c } }));
}

const { concept } = Astro.props;
const fullTitle = concept.title.join("");
const poster = posterUrl(concept.poster);
// "More concepts" candidate pool, ranked by relevance to this concept: same
// category first (tier 1), then everything else ordered by the canonical
// category sequence (tier 2). We render the top POOL candidates; the inline
// script below shuffles within each tier and reveals SHOW of them, so the picks
// stay relevant but feel fresh on every visit. With JS off, CSS shows the first
// SHOW (the most relevant) — see `.more .grid > .card:nth-child` in global.css.
const POOL = 8;
const SHOW = 4;
const rest = concepts
  .filter((c) => c.slug !== concept.slug && c.category !== concept.category)
  .sort((a, b) => CATEGORY_ORDER.indexOf(a.category) - CATEGORY_ORDER.indexOf(b.category));
const sameCat = concepts.filter((c) => c.slug !== concept.slug && c.category === concept.category);
const others = [...sameCat, ...rest].slice(0, POOL);
const importmap = JSON.stringify({ imports: { "@motion-canvas/core": "/animations/core.js" } });
---

<Base
  title={`${fullTitle} — solutionarch`}
  description={concept.summary}
  ogImage={poster}
>
  <Fragment slot="head">
    <script type="importmap" is:inline set:html={importmap} />
  </Fragment>

  <section class="concept container">
    <a class="back" href="/">← all concepts</a>

    <div class="concept-grid">
      <div class="stage-wrap">
        <div class="stage" id="stage" data-bundle={concept.bundle} data-slug={concept.slug}>
          <img class="poster" src={poster} alt={`${fullTitle} preview`} />
          <div class="overlay" id="overlay" role="button" tabindex="0" aria-label={`Play ${fullTitle} animation`}>
            <div class="btn"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></div>
          </div>
        </div>
      </div>

      <div class="concept-info">
        <span class="tag">{concept.category}</span>
        <h1>{concept.title[0]}<span class="accent">{concept.title[1]}</span></h1>
        <p class="question">{concept.question}</p>
        <p class="summary">{concept.summary}</p>
        {concept.details?.length > 0 && (
          <ul class="details">
            {concept.details.map((d) => <li>{d}</li>)}
          </ul>
        )}
        <span class="hint">Renders live in your browser, not a video — plays in view, click to pause.</span>
        <button class="share-btn" id="share-btn" type="button" data-title={fullTitle} data-summary={concept.summary}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span class="share-label">Share</span>
        </button>
        <span class="toast" id="toast" role="status" aria-live="polite" hidden></span>
        <span class="view-count mono" id="view-count" hidden></span>
      </div>
    </div>

    <div class="more">
      <h2>More concepts</h2>
      <div class="grid" id="more-grid" data-current-cat={concept.category} data-show={SHOW}>
        {others.map((c) => <ConceptCard concept={c} />)}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var stage = document.getElementById("stage");
      var overlay = document.getElementById("overlay");
      var bundle = stage.dataset.bundle;
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      var player = null;
      var userPaused = false;

      // load the Motion Canvas player runtime once, on demand (it pulls in core.js)
      function ensureRuntime() {
        if (window.__mcPlayerLoaded) return;
        window.__mcPlayerLoaded = true;
        var s = document.createElement("script");
        s.type = "module";
        s.src = "/animations/player.js";
        s.onerror = function () { window.__mcPlayerLoaded = false; pause(); };
        document.head.appendChild(s);
      }

      // keep the play button out of the tab order while the animation is running
      function showOverlay(show) {
        overlay.style.display = show ? "" : "none";
        overlay.setAttribute("aria-hidden", show ? "false" : "true");
        overlay.tabIndex = show ? 0 : -1;
      }

      function play() {
        if (player) return;
        userPaused = false;
        ensureRuntime();
        player = document.createElement("motion-canvas-player");
        player.setAttribute("src", bundle);
        player.setAttribute("auto", "true");
        player.setAttribute("width", "1080");
        player.setAttribute("height", "1920");
        player.setAttribute("aria-label", (document.title.split(" — ")[0] || "Concept") + " — animated diagram");
        stage.appendChild(player);
        showOverlay(false);
        // only fade the poster once the player actually upgrades; if player.js fails to
        // load the poster + play button stay instead of leaving a dead black stage
        var settled = false;
        customElements.whenDefined("motion-canvas-player").then(function () {
          settled = true;
          if (player) {
            stage.classList.add("playing");
            document.dispatchEvent(new CustomEvent("sa:concept-played", {detail: {slug: stage.dataset.slug}}));
          }
        });
        setTimeout(function () { if (!settled && player) pause(); }, 6000);
      }

      function pause() {
        if (player) { player.remove(); player = null; } // disconnect -> deactivate() stops the rAF loop
        stage.classList.remove("playing");
        showOverlay(true);
      }

      // play button (on the poster) starts/resumes; clicking the running animation pauses it
      overlay.addEventListener("click", function (e) { e.stopPropagation(); play(); });
      overlay.addEventListener("keydown", function (e) {
        if (e.key === "Enter" || e.key === " ") { e.preventDefault(); play(); }
      });
      stage.addEventListener("click", function () { if (player) { userPaused = true; pause(); } });

      // Autoplay when the stage is in view (unless reduced-motion), and pause when it scrolls
      // out of view or the tab is hidden, so the canvas never loops unseen. A manual pause
      // (userPaused) is remembered and not auto-resumed.
      function inView() { var r = stage.getBoundingClientRect(); return r.top < innerHeight * 0.9 && r.bottom > innerHeight * 0.1; }
      if (reduce) {
        // reduced-motion: leave the static poster + play button; no autoplay
      } else if ("IntersectionObserver" in window) {
        new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (en.isIntersecting && !document.hidden && !userPaused) play();
            else if (!en.isIntersecting) pause();
          });
        }, { threshold: 0.25 }).observe(stage);
        document.addEventListener("visibilitychange", function () {
          if (document.hidden) pause();
          else if (!userPaused && inView()) play();
        });
      } else {
        if (document.readyState === "complete") play(); else window.addEventListener("load", play);
      }
    })();
  </script>

  <script is:inline>
    // "More concepts": keep it relevant but fresh. The page renders a candidate
    // pool ordered by relevance (same category first); split it into tier 1
    // (same category as this concept) and tier 2 (the rest), shuffle each tier,
    // then keep the first `data-show` cards and drop the others from the DOM so
    // their lazy posters never fetch. Relevance wins slots first; order/fill
    // varies each visit. With JS off, CSS already shows the first 4.
    (function () {
      var grid = document.getElementById("more-grid");
      if (!grid) return;
      var show = parseInt(grid.getAttribute("data-show"), 10) || 4;
      var current = grid.getAttribute("data-current-cat");
      var cards = Array.prototype.slice.call(grid.querySelectorAll(".card"));
      function shuffle(a) {
        for (var i = a.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var t = a[i]; a[i] = a[j]; a[j] = t;
        }
        return a;
      }
      var tier1 = shuffle(cards.filter(function (c) { return c.dataset.category === current; }));
      var tier2 = shuffle(cards.filter(function (c) { return c.dataset.category !== current; }));
      tier1.concat(tier2).forEach(function (card, i) {
        if (i < show) grid.appendChild(card); // re-append the kept cards in shuffled order
        else card.remove();                   // drop extras; their lazy <img> never loads
      });
    })();
  </script>

  <script>
    import {readProgress, writeProgress} from "../../lib/storage";
    import {addSeen} from "../../lib/progress";
    import {formatCount} from "../../lib/views";

    const stage = document.getElementById("stage");
    const slug = stage?.dataset.slug;
    const countEl = document.getElementById("view-count");
    let shownCount = 0; // monotonic: a late/cached /api/stats response can't regress a fresh post-play count
    function showCount(n: number) {
      if (!countEl || n <= shownCount) return;
      shownCount = n;
      countEl.textContent = `${formatCount(n)} views`;
      countEl.hidden = false;
    }

    // initial social-proof count (also covers returning visitors who won't re-ping)
    if (slug) {
      fetch("/api/stats")
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => { if (d && typeof d.counts?.[slug] === "number") showCount(d.counts[slug]); })
        .catch(() => {});
    }

    // Count a view when the concept page opens, deduped once per browser session:
    // a new window / incognito re-counts, a refresh within the session does not
    // (sessionStorage; an in-memory flag backstops blocked storage). Only one slug
    // per page, so a single guard suffices.
    let viewCounted = false;
    function recordView(s: string) {
      if (viewCounted) return;
      viewCounted = true;
      try { if (sessionStorage.getItem(`sa.viewed.${s}`)) return; } catch { /* storage blocked */ }
      try { sessionStorage.setItem(`sa.viewed.${s}`, "1"); } catch { /* storage blocked */ }
      fetch("/api/view", {method: "POST", headers: {"content-type": "application/json"}, body: JSON.stringify({slug: s})})
        .then((r) => (r.ok ? r.json() : null))
        .then((d) => { if (d && typeof d.count === "number") showCount(d.count); })
        .catch(() => {});
    }
    if (slug) recordView(slug);

    // Mark the concept "seen" on first play — drives the explored bar + card
    // checkmarks (persistent per device, separate from the per-session view count).
    document.addEventListener("sa:concept-played", (e) => {
      const s = (e as CustomEvent).detail?.slug;
      if (!s) return;
      const prog = readProgress();
      if (!prog.seen.includes(s)) writeProgress({...prog, seen: addSeen(prog.seen, s)});
    });

    // Share: native sheet where supported, copy-link fallback otherwise
    const btn = document.getElementById("share-btn") as HTMLButtonElement | null;
    const toast = document.getElementById("toast");
    function flash(msg: string) {
      if (!toast) return;
      // clear then re-set next frame so a repeated identical message still announces (aria-live)
      toast.textContent = "";
      requestAnimationFrame(() => {
        toast.textContent = msg;
        toast.hidden = false;
      });
      setTimeout(() => (toast.hidden = true), 2000);
    }
    btn?.addEventListener("click", async () => {
      const url = location.href;
      const data = {title: btn.dataset.title || document.title, text: btn.dataset.summary || "", url};
      try {
        if (navigator.share) { await navigator.share(data); return; }
      } catch { return; }
      try { await navigator.clipboard.writeText(url); flash("Link copied"); }
      catch { flash(url); }
    });
  </script>
</Base>
